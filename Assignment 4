#include <stdio.h>

int main() {
    int rows = 2, cols = 2;
    int i = 0, j = 0;

    // Declare 2D arrays
    int a[2][2], b[2][2], sum[2][2];

    // Read elements of first matrix
    printf("Enter elements of the first 2x2 matrix:\n");
    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            scanf("%d", &a[i][j]);
        }
    }

    // Read elements of second matrix
    printf("Enter elements of the second 2x2 matrix:\n");
    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            scanf("%d", &b[i][j]);
        }
    }

    // Perform matrix addition
    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            sum[i][j] = a[i][j] + b[i][j];
        }
    }

    // Print the result
    printf("Sum of the two matrices:\n");
    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            printf("%d\t", sum[i][j]);
        }
        printf("\n");
    }

    return 0;
}
