#include <stdio.h>

#define MAX 100

struct Device {
    int id;
    char type[20];
    float Vf;
    float Ir;
    float ratedVoltage;
};

int main() {
    struct Device d[MAX];
    int n, i;
    float maxVf, maxIr, maxRated;

    printf("Enter number of devices: ");
    scanf("%d", &n);

    if (n <= 0 || n > MAX) {
        printf("Invalid number of devices!\n");
        return 0;
    }

    printf("\nEnter maximum permissible limits:\n");
    printf("Maximum Forward Voltage: ");
    scanf("%f", &maxVf);

    printf("Maximum Reverse Leakage Current: ");
    scanf("%f", &maxIr);

    printf("Maximum Rated Voltage: ");
    scanf("%f", &maxRated);

    for (i = 0; i < n; i++) {
        printf("\nEnter details of Device %d", i + 1);
        printf("\nEnter Device ID: ");
        scanf("%d", &d[i].id);

        printf("Enter Device Type (Diode/BJT/MOSFET/LED): ");
        scanf("%19s", d[i].type);

        printf("Enter Forward Voltage (Vf): ");
        scanf("%f", &d[i].Vf);

        printf("Enter Reverse Leakage Current (Ir): ");
        scanf("%f", &d[i].Ir);

        printf("Enter Rated Voltage: ");
        scanf("%f", &d[i].ratedVoltage);

        if (d[i].id <= 0 || d[i].Vf < 0 ||
            d[i].Ir < 0 || d[i].ratedVoltage < 0)
        {
            printf("Invalid device data!\n");
            return 0;
        }
    }

    printf("\n------ DEVICE DETAILS ------\n");

    for (i = 0; i < n; i++)
    {
        printf("\nDevice ID: %d", d[i].id);
        printf("\nDevice Type: %s", d[i].type);
        printf("\nForward Voltage: %.2f", d[i].Vf);
        printf("\nReverse Leakage Current: %.2f", d[i].Ir);
        printf("\nRated Voltage: %.2f", d[i].ratedVoltage);

        if (d[i].Vf <= maxVf &&
            d[i].Ir <= maxIr &&
            d[i].ratedVoltage <= maxRated)
        {
            printf("\nStatus: Within Operating Limits\n");
        }
        else
        {
            printf("\nStatus: Exceeds Operating Limits\n");
        }
    }

    return 0;
}
