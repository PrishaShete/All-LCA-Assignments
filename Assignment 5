#include <stdio.h>
#include <string.h>
#include <ctype.h>

#define MAX 200

// Helper function to read a full line safely without trailing newline
void readString(char *str, int size) {
    fgets(str, size, stdin);
    str[strcspn(str, "\n")] = '\0';
}

int main() {
    int choice;
    char str1[MAX], str2[MAX], result[MAX * 2];

    while (1) {
        printf("\n=========== STRING OPERATIONS MENU ===========\n");
        printf("1.  Find Length of String\n");
        printf("2.  Copy String\n");
        printf("3.  Concatenate Two Strings\n");
        printf("4.  Compare Two Strings\n");
        printf("5.  Reverse a String\n");
        printf("6.  Convert to Uppercase\n");
        printf("7.  Convert to Lowercase\n");
        printf("8.  Check Palindrome\n");
        printf("9.  Find Substring\n");
        printf("10. Count Vowels, Consonants, Digits & Spaces\n");
        printf("11. Exit\n");
        printf("================================================\n");
        printf("Enter your choice (1-11): ");

        if (scanf("%d", &choice) != 1) {
            printf("Invalid input. Please enter a number.\n");
            while (getchar() != '\n'); // Clear invalid input buffer
            continue;
        }
        getchar(); // Consume newline left by scanf

        switch (choice) {
            case 1: // Length
                printf("Enter a string: ");
                readString(str1, MAX);
                printf("Length of string: %zu\n", strlen(str1));
                break;

            case 2: // Copy
                printf("Enter source string: ");
                readString(str1, MAX);
                strcpy(result, str1);
                printf("Copied string: \"%s\"\n", result);
                break;

            case 3: // Concatenate
                printf("Enter first string: ");
                readString(str1, MAX);
                printf("Enter second string: ");
                readString(str2, MAX);
                strcpy(result, str1);
                strcat(result, str2);
                printf("Concatenated string: \"%s\"\n", result);
                break;

            case 4: // Compare
                printf("Enter first string: ");
                readString(str1, MAX);
                printf("Enter second string: ");
                readString(str2, MAX);
                {
                    int cmp = strcmp(str1, str2);
                    if (cmp == 0)
                        printf("Both strings are equal.\n");
                    else if (cmp > 0)
                        printf("First string is greater than second string.\n");
                    else
                        printf("First string is smaller than second string.\n");
                }
                break;

            case 5: // Reverse
                printf("Enter a string: ");
                readString(str1, MAX);
                {
                    size_t len = strlen(str1);
                    for (size_t i = 0; i < len / 2; i++) {
                        char temp = str1[i];
                        str1[i] = str1[len - 1 - i];
                        str1[len - 1 - i] = temp;
                    }
                    printf("Reversed string: \"%s\"\n", str1);
                }
                break;

            case 6: // Uppercase
                printf("Enter a string: ");
                readString(str1, MAX);
                for (int i = 0; str1[i] != '\0'; i++) {
                    str1[i] = (char)toupper((unsigned char)str1[i]);
                }
                printf("Uppercase string: \"%s\"\n", str1);
                break;

            case 7: // Lowercase
                printf("Enter a string: ");
                readString(str1, MAX);
                for (int i = 0; str1[i] != '\0'; i++) {
                    str1[i] = (char)tolower((unsigned char)str1[i]);
                }
                printf("Lowercase string: \"%s\"\n", str1);
                break;

            case 8: // Palindrome
                printf("Enter a string: ");
                readString(str1, MAX);
                {
                    size_t len = strlen(str1);
                    int isPal = 1;
                    for (size_t i = 0; i < len / 2; i++) {
                        if (str1[i] != str1[len - 1 - i]) {
                            isPal = 0;
                            break;
                        }
                    }
                    if (isPal)
                        printf("\"%s\" is a palindrome.\n", str1);
                    else
                        printf("\"%s\" is not a palindrome.\n", str1);
                }
                break;

            case 9: // Find Substring
                printf("Enter main string: ");
                readString(str1, MAX);
                printf("Enter substring to search: ");
                readString(str2, MAX);
                char *pos = strstr(str1, str2);
                if (pos != NULL)
                    printf("Substring found at index: %ld\n", pos - str1);
                else
                    printf("Substring not found.\n");
                break;

            case 10: // Character Statistics
                printf("Enter a string: ");
                readString(str1, MAX);
                int vowels = 0, consonants = 0, digits = 0, spaces = 0;
                for (int i = 0; str1[i] != '\0'; i++) {
                    char ch = (char)tolower((unsigned char)str1[i]);
                    if (ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u')
                        vowels++;
                    else if (ch >= 'a' && ch <= 'z')
                        consonants++;
                    else if (isdigit((unsigned char)ch))
                        digits++;
                    else if (ch == ' ')
                        spaces++;
                }
                printf("Vowels: %d | Consonants: %d | Digits: %d | Spaces: %d\n",
                       vowels, consonants, digits, spaces);
                break;

            case 11:
                printf("Exiting program. Goodbye!\n");
                return 0;

            default:
                printf("Invalid choice! Please select a number between 1 and 11.\n");
        }
    }
    return 0;
}
